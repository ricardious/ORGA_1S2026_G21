---
/**
 * Mapa de Karnaugh de 3 o 4 variables con las agrupaciones resaltadas.
 *
 * Las celdas se indexan por número de minterm, no por posición en la tabla: así
 * las agrupaciones se escriben igual aunque el orden Gray coloque `11` antes que
 * `10`. Con 3 variables las filas son una sola variable; con 4 pasan a ser un par
 * en orden Gray, y entonces el mapa envuelve también en vertical.
 *
 * Cuando una celda pertenece a varias agrupaciones —algo normal y deseable— el
 * fondo se reparte en franjas, de modo que se ve a simple vista que está
 * reutilizada.
 */
interface Group {
  /** Minterms que abarca la agrupación. */
  cells: number[];
  /** Término resultante, mostrado en la leyenda. */
  term: string;
}

interface Props {
  /** Tres o cuatro variables. Las primeras indexan las filas. */
  vars?: string[];
  /** Ocho o dieciséis caracteres `0`/`1`, en orden de minterm. */
  values: string;
  groups?: Group[];
  /** Qué se está agrupando: unos para SOP, ceros para POS. */
  target?: "ones" | "zeros";
  caption?: string;
}

const {
  vars = ["A", "B", "C"],
  values,
  groups = [],
  target = "ones",
  caption,
} = Astro.props;

// Orden Gray: entre etiquetas contiguas cambia un solo bit.
const GRAY = ["00", "01", "11", "10"];
const PALETTE = ["#2563EB", "#DC2626", "#059669", "#D97706"];

const fourVars = vars.length === 4;
const ROWS = fourVars ? GRAY : ["0", "1"];
const COLUMNS = GRAY;
const rowVar = fourVars ? vars[0] + vars[1] : vars[0];
const colVar = fourVars ? vars[2] + vars[3] : vars[1] + vars[2];

const expected = fourVars ? 16 : 8;
if (values.length !== expected) {
  throw new Error(
    `<KMap />: con ${vars.length} variables se esperaban ${expected} valores, llegaron ${values.length}: "${values}"`,
  );
}

/**
 * Minterm de la celda situada en la fila y la columna indicadas. Las etiquetas
 * ya vienen en binario, así que basta con concatenarlas: la fila aporta los bits
 * de mayor peso.
 */
function minterm(row: string, col: string): number {
  return parseInt(row, 2) * 4 + parseInt(col, 2);
}

function background(cellGroups: number[]): string | undefined {
  if (cellGroups.length === 0) return undefined;
  const tint = (index: number) =>
    `color-mix(in srgb, ${PALETTE[index % PALETTE.length]} 26%, transparent)`;
  if (cellGroups.length === 1) return tint(cellGroups[0]);
  // Franjas de igual ancho, una por agrupación que cubre la celda.
  const step = 100 / cellGroups.length;
  const stops = cellGroups.map(
    (g, i) => `${tint(g)} ${i * step}% ${(i + 1) * step}%`,
  );
  return `linear-gradient(135deg, ${stops.join(", ")})`;
}

const rows = ROWS.map((row) => ({
  row,
  cells: COLUMNS.map((col) => {
    const m = minterm(row, col);
    const belongs = groups
      .map((g, index) => (g.cells.includes(m) ? index : -1))
      .filter((index) => index >= 0);
    return { minterm: m, value: values[m], background: background(belongs) };
  }),
}));

const highlighted = target === "ones" ? "1" : "0";
---

<figure class="kmap">
  <table>
    <thead>
      <tr>
        <th class="corner">{rowVar}\{colVar}</th>
        {COLUMNS.map((col) => <th>{col}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ row, cells }) => (
          <tr>
            <th>{row}</th>
            {cells.map((cell) => (
              <td
                style={cell.background ? `background:${cell.background}` : undefined}
                class={cell.value === highlighted ? "target" : undefined}
              >
                {cell.value}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    groups.length > 0 && (
      <ul class="legend">
        {groups.map((group, index) => (
          <li>
            <span
              class="swatch"
              style={`--swatch:${PALETTE[index % PALETTE.length]}`}
            />
            <code>{group.term}</code>
          </li>
        ))}
      </ul>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .kmap {
    margin: 1.5rem 0;
  }

  .kmap table {
    border-collapse: collapse;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .kmap th,
  .kmap td {
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.4rem 0.85rem;
    text-align: center;
    line-height: 1.3;
  }

  .kmap thead th,
  .kmap tbody th {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }

  .kmap .corner {
    font-size: var(--sl-text-xs);
    white-space: nowrap;
  }

  .kmap td {
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }

  /* El valor que se está agrupando se destaca del resto. */
  .kmap td.target {
    color: var(--sl-color-white);
  }

  .kmap .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kmap .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .kmap .swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--swatch) 26%, transparent);
    border: 1.5px solid var(--swatch);
    flex-shrink: 0;
  }

  .kmap figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
