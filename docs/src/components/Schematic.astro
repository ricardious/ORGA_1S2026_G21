---
/**
 * Esquema vectorial servido desde `public/svg/`.
 *
 * A diferencia de `<Figure />`, estos archivos no pasan por el optimizador de
 * Astro: son SVG (o WebP animado) donde el procesamiento no aporta nada y sí
 * puede romperlos. El componente resuelve el `base` del sitio y normaliza el
 * tamaño, porque los esquemas se exportan con dimensiones muy distintas entre sí.
 *
 * Los SVG no llevan fondo propio: se ven directamente sobre el fondo de la
 * página. El CSS global invierte `img[src$=".svg"]` en modo oscuro, de modo que
 * los trazos se aclaran y los colores se conservan sin una segunda versión.
 */
interface Props {
  /** Ruta relativa a `public/svg/`, p. ej. `fundamentos/circuito_inversor.svg`. */
  src: string;
  alt: string;
  caption?: string;
  /**
   * Tope de altura. Por defecto el diagrama ocupa todo el ancho disponible;
   * este límite evita que los formatos verticales crezcan desproporcionadamente
   * al escalarlos, ya que un SVG no pierde nitidez al ampliarse.
   */
  maxHeight?: string;
}

const { src, alt, caption, maxHeight = "40rem" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<figure class="schematic">
  {/* Al reducirse al ancho de la columna, un pinout de dieciséis pines deja el
      texto por debajo de lo cómodo. El enlace abre el SVG a tamaño completo, que
      al ser vectorial se puede ampliar sin límite. */}
  <a href={`${base}/svg/${src}`} target="_blank" rel="noopener" title="Abrir a tamaño completo">
    <img
      src={`${base}/svg/${src}`}
      alt={alt}
      style={`max-height:${maxHeight}`}
      loading="lazy"
      decoding="async"
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .schematic {
    margin: 2rem 0;
  }

  .schematic a {
    display: block;
    /* El enlace no debe parecer un enlace de texto dentro del contenido. */
    text-decoration: none;
    border-radius: 0.35rem;
  }

  .schematic a:hover {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  .schematic img {
    display: block;
    width: 100%;
    height: auto;
    /* Los formatos verticales quedan limitados por la altura: `contain` los
       reduce y los centra en vez de deformarlos. */
    object-fit: contain;
  }

  .schematic figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    text-align: center;
    text-wrap: balance;
  }
</style>
